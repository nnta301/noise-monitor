{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Telemetry Contract v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "v1"
    },
    "device_id": {
      "type": "string",
      "minLength": 1
    },
    "boot_id": {
      "type": "string",
      "minLength": 1,
      "format": "uuid"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "measured_at": {},
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "time_sync_status": {
      "type": "string",
      "enum": ["synced", "unsynced", "monotonic"]
    },
    "median_p2p": {
      "type": "array",
      "items": {
        "type": ["integer", "null"],
        "minimum": 0
      },
      "minItems": 10,
      "maxItems": 10
    },
    "peak_p2p": {
      "type": "array",
      "items": {
        "type": ["integer", "null"],
        "minimum": 0
      },
      "minItems": 10,
      "maxItems": 10
    },
    "quality_flags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["ok", "clipping", "out_of_range", "missing"]
      },
      "minItems": 10,
      "maxItems": 10
    }
  },
  "required": [
    "schema_version",
    "device_id",
    "boot_id",
    "sequence",
    "measured_at",
    "timezone",
    "time_sync_status",
    "median_p2p",
    "peak_p2p",
    "quality_flags"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "time_sync_status": { "const": "synced" }
        },
        "required": ["time_sync_status"]
      },
      "then": {
        "properties": {
          "measured_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "time_sync_status": { "const": "unsynced" }
        },
        "required": ["time_sync_status"]
      },
      "then": {
        "properties": {
          "measured_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "time_sync_status": { "const": "monotonic" }
        },
        "required": ["time_sync_status"]
      },
      "then": {
        "properties": {
          "measured_at": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  ]
}
