{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Telemetry 202 Accepted Response",
  "type": "object",
  "properties": {
    "outcome": {
      "type": "string",
      "enum": ["accepted", "duplicate"]
    },
    "packet_key": {
      "type": "object",
      "properties": {
        "device_id": {"type": "string", "minLength": 1},
        "boot_id": {"type": "string", "format": "uuid"},
        "sequence": {"type": "integer", "minimum": 0}
      },
      "required": ["device_id", "boot_id", "sequence"],
      "additionalProperties": false
    }
  },
  "required": ["outcome", "packet_key"],
  "additionalProperties": false
}
